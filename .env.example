# Casino Calendar Environment Configuration
# Copy this file to .env in the project root and modify as needed

# Logging Configuration
# Set to DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# Optional: Enable file logging (comment out to disable file logging)
# LOG_FILE=logs/casino_calendar.log

# Development settings (uncomment for development)
# LOG_LEVEL=DEBUG
# LOG_FILE=logs/casino_calendar_dev.log

# Production settings (uncomment for production)
# LOG_LEVEL=WARNING
# LOG_FILE=logs/casino_calendar_prod.log
