# Casino Calendar Environment Configuration
# Copy this file to .env in the project root and modify as needed

# Timezone Configuration
# Purpose: Controls the timezone used to interpret and display casino events.
# Options: Any IANA timezone identifier (e.g., America/Los_Angeles, UTC).
APP_TIMEZONE=America/Los_Angeles

# Logging Configuration
# Purpose: Sets the minimum log severity written to console and files.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
# Purpose: Defines the destination file for main application logs.
# Options: Relative or absolute path; leave blank to use logs/casino_calendar.log.
LOG_FILE=logs/casino_calendar.log
# Purpose: Defines the destination file for scan ingest logs.
# Options: Relative or absolute path; leave blank to use logs/scan_ingest.log.
SCAN_INGEST_LOG_FILE=logs/scan_ingest.log
# Purpose: Comma-separated PSM values to sweep for OCR; set to none to disable.
# Options: Integers like 3,6,11 or "none".
TESSERACT_PSM_SWEEP=3,6,11
# Purpose: Enables preprocessing (grayscale + autocontrast + thresholding) before OCR.
# Options: true, false.
SCAN_OCR_PREPROCESS=true
# Purpose: Keep preprocessed OCR images for debugging.
# Options: true, false.
SCAN_OCR_KEEP_PREPROCESSED=false
# Purpose: Suppresses noisy HTTP GET/POST lines from console output.
# Options: true, false (case-insensitive; true hides HTTP access logs from console).
SUPPRESS_HTTP_LOGS=True
# Purpose: When truthy, trims console/file output to startup and shutdown lines for tests.
# Options: leave blank to disable; set to true/1/on to enable minimal logging.
CASINO_MINIMAL_TEST_LOG=
# Purpose: Controls the severity threshold for maintenance/cleanup scripts.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL.
MAINTENANCE_LOG_LEVEL=INFO
# Purpose: Chooses where maintenance script logs are written.
# Options: Relative or absolute path; leave blank for logs/casino_calendar_maintenance.log.
MAINTENANCE_LOG_FILE=
# Purpose: Archives or copies the existing main log before the app starts.
# Options: move, copy, false (false keeps the current log untouched on startup).
ARCHIVE_APP_LOG_ON_STARTUP=false
# Purpose: Minimum alphanumeric score to treat a PDF as text-based (skip OCR when met).
# Options: Integer threshold; higher values require more detected text.
OCR_TEXT_LAYER_THRESHOLD=50
# Purpose: When true, saves per-source OCR text outputs alongside the PDF.
# Options: true, false.
SCAN_OCR_SAVE_SOURCES=false
# Purpose: When true, saves OCR metadata JSON alongside the PDF.
# Options: true, false.
SCAN_OCR_SAVE_METADATA=false
# Purpose: Forces JSON configuration caches to refresh when set.
# Options: leave blank to reuse cache; set any non-empty value to bust the cache.
CONFIG_CACHE_BUST=

# Dash Development Settings
# Purpose: Enables Flask debug server with auto reload and verbose errors.
# Options: true, false (true enables debug mode).
DEBUG=False
# Purpose: Toggles Dash DevTools (hot reload, component inspector).
# Options: true, false (true enables Dash Dev Tools and hot reload).
DASH_DEBUG=True

# Python Module Search Path
# Purpose: Extends module discovery for Python imports at runtime.
# Options: Semicolon-separated directories added to Python module resolution.
PYTHONPATH=.
