# .gitignore

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.mypy_cache/
.pytest_cache/

# Virtual environments
.venv/
env/
venv/

# OS junk
.DS_Store
Thumbs.db

# IDE settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Logs and artifacts
logs/
*.log
*.log.1
*.log.2
*.log.3
*.log.4
*.log.5
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/

# Render-specific (if any local build artifacts)
build/

# Package distributions
dist/
*.egg-info/

# Environment files
.env
*.env

# Database files
*.sqlite3

# Node dependencies
node_modules/

.fake
# Generated Dash assets
assets/dist/*.css
