# .gitignore

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
env/
venv/

# OS junk
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/

# Logs and artifacts
*.log

# Render-specific (if any local build artifacts)
build/

# Package distributions
dist/
*.egg-info/

# Environment files
.env
*.env

# Database files
*.sqlite3

# Node dependencies
node_modules/
