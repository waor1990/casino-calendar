# .gitignore

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
env/
venv/

# OS junk
.DS_Store
Thumbs.db

# IDE settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Logs and artifacts
logs/

# Render-specific (if any local build artifacts)
build/

# Package distributions
dist/
*.egg-info/

# Environment files
.env
*.env

# Database files
*.sqlite3

# Scan inbox artifacts
data/raw/Casino_Scans/

# Node dependencies
node_modules/

# Generated Dash assets
assets/dist/*.css

# Temporary files
*.tmp

# Cache files
data/cache/
.coverage

.fake
