{
    "name": "casino-calendar",
    "version": "1.0.0",
    "description": "Dash casino event calendar assets",
    "private": true,
    "engines": {
        "node": "^22.9.0",
        "npm": ">=10"
    },
    "volta": {
        "node": "22.9.0"
    },
    "scripts": {
        "build:css": "sass --no-source-map assets/styles/index.scss assets/dist/style.css",
        "watch:css": "sass --no-source-map --watch assets/styles/index.scss assets/dist/style.css",
        "lint:css": "stylelint --config config/linting/.stylelintrc.json \"assets/**/*.scss\"",
        "lint:package-json": "node scripts/node/verify-package-json.mjs",
        "clean:node-modules": "node scripts/node/cleanup-node-modules.mjs",
        "preinstall": "node scripts/node/cleanup-node-modules.mjs",
        "setup": "npm run clean:node-modules && npm install && npm run build:css",
        "dev": "npm run watch:css"
    },
    "devDependencies": {
        "@stylistic/stylelint-plugin": "^3.1.3",
        "sass": "^1.77.0",
        "stylelint": "^16.21.1",
        "stylelint-config-standard": "^38.0.0",
        "stylelint-config-standard-scss": "^15.0.1"
    }
}