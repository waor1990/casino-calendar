{
    "name": "casino-calendar",
    "version": "1.0.0",
    "description": "Dash casino event calendar assets",
    "private": true,
    "scripts": {
        "build:css": "sass --no-source-map assets/style.scss assets/style.css",
        "watch:css": "sass --no-source-map --watch assets/style.scss assets/style.css",
        "lint:css": "stylelint --config config/.stylelintrc.json 'assets/**/*.scss'",
        "setup": "npm install && npm run build:css",
        "dev": "npm run watch:css"
    },
    "devDependencies": {
        "@stylistic/stylelint-plugin": "^3.1.3",
        "sass": "^1.77.0",
        "stylelint": "^16.21.1",
        "stylelint-config-standard": "^38.0.0",
        "stylelint-config-standard-scss": "^15.0.1"
    }
}