{
    "name": "casino-calendar",
    "version": "1.0.0",
    "description": "Dash casino event calendar assets",
    "private": true,
    "engines": {
        "node": "^22.9.0",
        "npm": ">=10"
    },
    "volta": {
        "node": "22.9.0"
    },
    "scripts": {
        "build:css": "sass --no-source-map assets/styles/index.scss assets/dist/style.css",
        "watch:css": "sass --no-source-map --watch assets/styles/index.scss assets/dist/style.css",
        "lint:css": "npm run lint:css:check",
        "lint:css:check": "stylelint --config config/linting/.stylelintrc.json --formatter verbose \"assets/**/*.scss\"",
        "lint:css:fix": "stylelint --config config/linting/.stylelintrc.json \"assets/**/*.scss\" --fix",
        "lint:package-json": "node scripts/node/verify-package-json.mjs",
        "clean:node-modules": "node scripts/node/cleanup-node-modules.mjs",
        "preinstall": "node scripts/node/cleanup-node-modules.mjs",
        "setup": "npm run clean:node-modules && npm install && npm run build:css",
        "dev": "npm run watch:css",
        "prepare": "husky",
        "commit": "git-cz",
        "auto-commit": ".venv\\Scripts\\python.exe scripts/python/auto_commit.py"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.3.0",
        "@commitlint/config-conventional": "^20.3.0",
        "@stylistic/stylelint-plugin": "^4.0.0",
        "commitizen": "^4.3.1",
        "cz-customizable": "^7.5.1",
        "husky": "^9.1.7",
        "sass": "^1.97.1",
        "stylelint": "^16.26.1",
        "stylelint-config-standard": "^39.0.1",
        "stylelint-config-standard-scss": "^16.0.0"
    },
    "overrides": {
        "tmp": "0.2.5"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-customizable"
        }
    }
}